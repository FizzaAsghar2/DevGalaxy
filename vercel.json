{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/export.js": {
      "includeFiles": "{src/**,api/**,public/**,supabase/**,docs/**,tests/**,tsconfig.json,README.md,AGENTS.md,package.json,package-lock.json,index.html,vite.config.js,tailwind.config.js,postcss.config.js,.oxlintrc.json,vercel.json,.env.example,.gitignore}"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
