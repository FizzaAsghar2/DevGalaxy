# ---------------------------------------------------------------- frontend
# Clerk (https://dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>

# Supabase (https://supabase.com/dashboard → Project settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# ------------------------------------------------- server only (never VITE_)
# Clerk secret key, used by /api/generate to verify the caller's session token.
CLERK_SECRET_KEY=<clerk-secret-key>

# AI provider (server only). Used by the architecture generator and Galaxy Studio.
# AI_PROVIDER: openai (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Together, …) | anthropic | gemini
AI_PROVIDER=openai
AI_API_KEY=<ai-provider-api-key>
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional cheaper model for small Galaxy Studio edits.
AI_MODEL_FAST=
# Optional request timeout in milliseconds (default 90000).
AI_TIMEOUT_MS=

# Supabase service-role key. Server only: used by /api/* to read roles and to
# record AI usage. Required for accounts, usage tracking, /admin and source export.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Optional; defaults to VITE_SUPABASE_URL.
SUPABASE_URL=

# Personal AI cost control (optional). Leave empty for no cap.
AI_MAX_REQUEST_USD=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
# Optional: price per million tokens, to turn reported token usage into cost.
AI_USD_PER_MILLION_TOKENS=

# Optional: repository used for the "main branch .zip" fallback in Settings → Export.
VITE_SOURCE_REPO_URL=https://github.com/FizzaAsghar2/DevGalaxy
