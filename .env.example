# ---------------------------------------------------------------- frontend
# Clerk (https://dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>

# Supabase (https://supabase.com/dashboard → Project settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# ------------------------------------------------- server only (never VITE_)
# Clerk secret key, used by /api/generate to verify the caller's session token.
CLERK_SECRET_KEY=<clerk-secret-key>

# Any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Together, …).
AI_API_KEY=<ai-provider-api-key>
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Supabase service-role key. Server only: used by /api/* to read roles, plans and
# usage and to record usage. Required for accounts, plan limits and /admin.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Optional; defaults to VITE_SUPABASE_URL.
SUPABASE_URL=

# Billing (not wired yet). Pro checkout stays disabled until both are set and a
# verified webhook handler grants subscriptions server-side.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
